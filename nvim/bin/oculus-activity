#!/usr/bin/env -S nvim -l
-- Usage:
--   oculus-activity            fetch tracked projects, write activity.json
--   oculus-activity --force    ignore the unauthenticated rate-limit window
--   oculus-activity --seen KEY mark one project seen (e.g. github:neovim/neovim)
--   oculus-activity --seen-all mark every project seen

local script = vim.uv.fs_realpath(arg[0]) or arg[0]
local root = vim.fn.fnamemodify(script, ":h:h")
local oculus = vim.env.OCULUS_NVIM_PATH
  or (vim.fn.stdpath("data") .. "/lazy/oculus.nvim")

vim.opt.rtp:append(root)
vim.opt.rtp:append(oculus)

local activity = require("oculus_omarchy.activity")
local args = { unpack(arg) }

if args[1] == "--seen" and args[2] then
  activity.mark_seen({ args[2] })
elseif args[1] == "--seen-all" then
  activity.mark_seen(nil)
else
  local result, note = activity.refresh({ force = args[1] == "--force" })

  io.stdout:write(("%s new across %d projects%s\n"):format(
    result and result.total_new or 0,
    result and #result.projects or 0,
    note and (" (" .. note .. ")") or ""
  ))
end
