#!/usr/bin/env -S nvim -l
-- Add a project or user to the oculus.nvim tracking file, then ask a running
-- Neovim (from omarchy.json) to :OculusReloadTracking.
--
-- Usage:
--   oculus-track [--file PATH] <github|codeberg> <owner/repo>   track a project
--   oculus-track [--file PATH] <github|codeberg> <login>        track a user

local script = vim.uv.fs_realpath(arg[0]) or arg[0]
local root = vim.fn.fnamemodify(script, ":h:h")
local oculus = vim.env.OCULUS_NVIM_PATH
  or (vim.fn.stdpath("data") .. "/lazy/oculus.nvim")

vim.opt.rtp:append(root)
vim.opt.rtp:append(oculus)

local args = { unpack(arg) }
local file = nil

if args[1] == "--file" then
  file = args[2]
  table.remove(args, 1)
  table.remove(args, 1)
end

local track = require("oculus_omarchy.track")
local ok, message = track.add(args[1], args[2], file)

if not ok then
  io.stderr:write(message .. "\n")
  os.exit(1)
end

io.stdout:write(message .. "\n")
