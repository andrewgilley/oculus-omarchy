#!/bin/bash
# Open a project's Oculus activity feed in Neovim, in the default terminal
# (Ghostty), on an empty workspace on the current monitor.
#
# Usage: oculus-open-project <github:owner/repo | codeberg:owner/repo | owner/repo>
set -euo pipefail

key="${1:-}"

# The key is interpolated into a Lua string below, so allow identity
# characters only.
if [[ ! $key =~ ^((github|codeberg):)?[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  echo "usage: oculus-open-project <github:owner/repo | codeberg:owner/repo | owner/repo>" >&2
  exit 2
fi

# Hyprland 0.56+ (Lua config): `dispatch` takes a Lua dispatcher expression.
hyprctl dispatch 'hl.dsp.focus({ workspace = "emptym" })' >/dev/null

# Use -c, not +cmd: Ghostty's -e drops arguments that start with "+" (it
# reserves them for its own +actions).
exec omarchy-launch-tui --app-id=org.omarchy.oculus \
  nvim -c "lua require('oculus').open_project('$key')"
