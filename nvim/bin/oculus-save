#!/usr/bin/env -S nvim -l
-- Save a pull request, issue or commit to oculus.nvim's saved items, or remove
-- saved items, then ask a running Neovim (from omarchy.json) to reload them.
--
-- Usage:
--   oculus-save [--file PATH] <url>              save the item at a forge URL
--   oculus-save [--file PATH] --remove <key>...  remove saved items by key
--
-- URL is a GitHub or Codeberg pull request, issue or commit page. PATH is
-- oculus.nvim's state_file, stdpath("state")/oculus.json unless you changed it.

local script = vim.uv.fs_realpath(arg[0]) or arg[0]
local root = vim.fn.fnamemodify(script, ":h:h")
local oculus = vim.env.OCULUS_NVIM_PATH
  or (vim.fn.stdpath("data") .. "/lazy/oculus.nvim")

vim.opt.rtp:append(root)
vim.opt.rtp:append(oculus)

local save = require("oculus_omarchy.save")
local args = { unpack(arg) }
local file, remove = nil, false

local function fail(message)
  io.stderr:write(message .. "\n")
  os.exit(1)
end

while args[1] and args[1]:sub(1, 2) == "--" do
  local flag = table.remove(args, 1)

  if flag == "--remove" then
    remove = true
  elseif flag == "--file" then
    file = table.remove(args, 1) or fail("--file needs a value")
  else
    fail("unknown option " .. flag)
  end
end

if #args == 0 or (not remove and #args > 1) then
  fail("usage: oculus-save [--file PATH] <url> | oculus-save [--file PATH] --remove <key>...")
end

local ok, message

if remove then
  ok, message = save.remove(args, file)
else
  ok, message = save.add(args[1], file)
end

if not ok then
  fail(message)
end

io.stdout:write(message .. "\n")
