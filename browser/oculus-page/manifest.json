{
  "manifest_version": 3,
  "name": "Oculus Page",
  "version": "0.4.0",
  "description": "Tells the Omarchy Oculus bar widget which GitHub or Codeberg page is open. It can only see pages on those two sites.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://github.com/*", "https://www.github.com/*", "https://codeberg.org/*"],
  "background": { "service_worker": "background-1.js" }
}
